    {
      "name": "4. Flujo completo de alquiler",
      "item": [
        {
          "name": "4.1 CLIENTE solicita reserva (herramienta 23, sin confirmación automática)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"herramientaId\": 23,\n  \"fechaInicio\": \"{{inicio}}\",\n  \"fechaFin\": \"{{fin}}\",\n  \"observaciones\": \"Prueba Postman\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"inicio\", (() => { const d = new Date(); d.setDate(d.getDate() + 30); return d.toISOString().slice(0,10); })());",
                  "pm.collectionVariables.set(\"fin\", (() => { const d = new Date(); d.setDate(d.getDate() + 32); return d.toISOString().slice(0,10); })());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Queda PENDIENTE o APROBADA\", () => pm.expect([\"PENDIENTE\",\"APROBADA\"]).to.include(r.estado));",
                  "pm.collectionVariables.set(\"reservaId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Reserva duplicada en las mismas fechas → 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"herramientaId\": 23,\n  \"fechaInicio\": \"{{inicio}}\",\n  \"fechaFin\": \"{{fin}}\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "4.3 PROVEEDOR de la herramienta aprueba",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservas/{{reservaId}}/aprobar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas",
                "{{reservaId}}",
                "aprobar"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "description": "Se usa el token de ADMIN para no depender de qué proveedor es dueño de la herramienta. Si la reserva ya nació APROBADA responde 400."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Aprobada (o ya estaba aprobada)\", () => pm.expect([200, 400]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "4.4 CLIENTE paga (pasarela simulada)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pagos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pagos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservaId\": \"{{reservaId}}\",\n  \"metodo\": \"PSE\",\n  \"ultimosDigitos\": \"4242\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Pago aprobado\", () => pm.expect(j.pago.estado).to.eql(\"APROBADO\"));",
                  "pm.test(\"Factura generada automáticamente\", () => pm.expect(j.factura.numero).to.match(/^FAC-/));",
                  "pm.collectionVariables.set(\"facturaId\", pm.response.json().factura.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "4.5 Pagar dos veces → 400/409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pagos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pagos"
              ]
            },
